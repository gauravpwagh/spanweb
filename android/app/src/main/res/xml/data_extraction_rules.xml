<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the vault out of cloud backup and device-to-device transfer. Its key
     lives in this phone's Keystore, so a restored copy could not be opened
     anyway. Use Export to move links to another phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
